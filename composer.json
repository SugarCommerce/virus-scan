{
  "name": "sugarcommerce/virus-scan",
  "version": "1.0.0",
  "description": "Malware scanning for stored uploads: ClamAV over clamd's INSTREAM, a VirusTotal lookup by digest, and a panel that combines them without mistaking an outage for a clean bill of health. Files are read a range at a time, so a two-gigabyte upload never sits in memory.",
  "type": "library",
  "license": "GPL-2.0-or-later",
  "homepage": "https://github.com/sugarcommerce/virus-scan",
  "authors": [ { "name": "David Sherlock", "homepage": "https://arraypress.com/" } ],
  "keywords": ["malware", "antivirus", "clamav", "clamd", "virustotal", "uploads", "security"],
  "require": {
    "php": ">=8.5",
    "sugarcommerce/http-client": "^1.0"
  },
  "require-dev": { "phpunit/phpunit": "^13.0" },
  "autoload": { "psr-4": { "SugarCommerce\\VirusScan\\": "src/" } },
  "autoload-dev": { "psr-4": { "SugarCommerce\\VirusScan\\Tests\\": "tests/" } },
  "repositories": [ { "type": "path", "url": "../*", "options": { "symlink": true } } ],
  "scripts": { "test": "phpunit" },
  "config": { "optimize-autoloader": true, "sort-packages": true, "preferred-install": "dist" },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "support": { "issues": "https://github.com/sugarcommerce/virus-scan/issues", "source": "https://github.com/sugarcommerce/virus-scan" }
}
